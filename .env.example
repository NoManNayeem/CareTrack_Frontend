# ── Backend ───────────────────────────────────────────────
# Base URL of the CareTrack Express API (server-side only — used by the /api rewrite).
#   Local dev:        http://localhost:4000
#   Docker compose:   http://api:4000
#   Production:       https://caretrack-backend.vercel.app
API_URL=http://localhost:4000

# Name of the session cookie set by the API (must match the API's COOKIE_NAME).
SESSION_COOKIE_NAME=ct_session

# ── Demo helpers (optional) ───────────────────────────────
# Shows a "Use demo credentials" button on the login page for reviewers.
NEXT_PUBLIC_DEMO_MODE=true
NEXT_PUBLIC_DEMO_EMAIL=admin@caretrack.dev
NEXT_PUBLIC_DEMO_PASSWORD=CareTrack@2026
