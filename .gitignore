# ── Dependencies ─────────────────────────────────────────
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# ── Next.js build output ─────────────────────────────────
/.next/
/out/
/build
next-env.d.ts
*.tsbuildinfo

# ── Testing ──────────────────────────────────────────────
/coverage
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/
# Playwright signed-in session (contains a session cookie)
/e2e/.auth/

# ── Environment & secrets (never commit) ─────────────────
.env
.env.*
!.env.example
*.pem
*.key

# ── Deployment ───────────────────────────────────────────
/.vercel

# ── Logs ─────────────────────────────────────────────────
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# ── Editors & OS ─────────────────────────────────────────
.vscode/*
!.vscode/extensions.json
.idea/
*.swp
.DS_Store
Thumbs.db

# ── AI assistant local settings ──────────────────────────
.claude/
